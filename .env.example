# ─── Core (required) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/collections
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=your-long-random-secret-here   # REQUIRED in production (server refuses to boot without it)
PORT=3001
NODE_ENV=development

# ─── Document storage ─────────────────────────────────────────────────────────
# 'local' (default) writes to disk and is EPHEMERAL on Railway — uploads are lost on
# redeploy. Use 's3' (S3 or Cloudflare R2) in production.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads          # local driver: directory (and S3 driver: temp staging)
MAX_FILE_SIZE_MB=25

# S3 / R2 (required when STORAGE_DRIVER=s3):
# S3_BUCKET=
# S3_REGION=auto              # 'auto' for R2; a real region for AWS
# S3_ENDPOINT=               # set for Cloudflare R2 / MinIO; omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Phase A — vendor keys ────────────────────────────────────────────────────
LOB_API_KEY=live_or_test_...
RESEND_API_KEY=re_...
DROPBOX_SIGN_API_KEY=...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email sender (Resend) — verify SPF/DKIM/DMARC on this domain
EMAIL_SENDER_DOMAIN=mail.reclaimful.com
EMAIL_FROM_ADDRESS=hello@mail.reclaimful.com

# Auto follow-up scheduler (BullMQ) — scheduler is a no-op if unset
REDIS_URL=redis://localhost:6379

# Public base URL — used in debtor portal links and Stripe success/cancel URLs
PUBLIC_BASE_URL=http://localhost:5173

# ─── Phase B — vendor keys ────────────────────────────────────────────────────
PROOF_API_KEY=               # Proof.com — notary (RON) + process serve
INFOTRACK_API_KEY=           # InfoTrack — NYSCEF / EDDS paid e-filing

# ─── Debtor research integrations (optional — features degrade gracefully) ─────
PACER_USERNAME=              # PACER account — required for the federal bankruptcy lookup
PACER_PASSWORD=
NYC_OPEN_DATA_TOKEN=         # raises rate limits on ACRIS + ECB lookups
ECB_DATASET_ID=             # override if the NYC ECB dataset id changes
# Residential/datacenter proxy for portals that block cloud IPs (NYS UCC, PACER, NY courts).
# undici ProxyAgent format, e.g. http://user:pass@host:port
PROXY_URL=

# ─── Local dev only ───────────────────────────────────────────────────────────
# PDF rendering uses @sparticuz/chromium (bundled Chromium) on the deployed Linux build.
# On macOS/Windows for local dev, point this at your installed Chrome so PDF downloads work:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
